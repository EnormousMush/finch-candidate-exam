{
  "name": "points-exchange",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "NODE_USE_ENV_PROXY=1 tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:fake": "concurrently -k -n fake,api,web -c yellow,blue,magenta \"pnpm fake-api\" \"NO_PROXY=localhost,127.0.0.1 DIGITAL_GOODS_BASE_URL=http://127.0.0.1:4010 pnpm dev:api\" \"pnpm dev:web\"",
    "fake-api": "tsx scripts/fake-api.ts",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:setup": "tsx server/db/cli.ts migrate seed",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_USE_ENV_PROXY=1 tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
