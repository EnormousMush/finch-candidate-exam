# PostgreSQL 连接串。docker compose 用下面的默认值即可；
# Homebrew 安装的 Postgres 没有 postgres 用户，两个 URL 都要改成 postgres://<你的系统用户名>@localhost:5432/...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/points_exchange
# 测试专用库，pnpm test 会自动创建并清空；库名必须以 _test 结尾，切勿指向开发库
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/points_exchange_test

# 外部数字商品 API（只在服务端使用，不要提交真实 Key）
DIGITAL_GOODS_BASE_URL=https://digital-goods-api.vercel.app
DIGITAL_GOODS_API_KEY=dg_xxx

PORT=3000
# 前端开发服务器端口（pnpm dev），默认 5173
WEB_PORT=5173
# pnpm dev:fake 使用的本地假外部 API 端口
FAKE_API_PORT=4010
# 部署在 HTTPS 下时设为 true，cookie 会加 Secure 标记；本地 http 演示保持 false
COOKIE_SECURE=false
